# --- Database ---------------------------------------------------------------
# Dev: Postgres from compose.yaml (podman). Prod: Neon connection string.
DATABASE_URL=postgres://caselaw:caselaw@localhost:5433/caselaw

# --- LLM --------------------------------------------------------------------
# Precedence: OPENROUTER_API_KEY → ANTHROPIC_API_KEY → AI_GATEWAY_API_KEY
# (Vercel AI Gateway; on Vercel, OIDC auth works without a key).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# Optional model overrides (ids for whichever provider is active)
# LLM_FAST_MODEL=claude-haiku-4-5          (OpenRouter e.g. stealth/space-bunny-alpha)
# LLM_STRONG_MODEL=claude-sonnet-5-5
# OpenRouter: pin providers per model (no provider fallback), and a model to retry with on failure
# OPENROUTER_PROVIDERS=deepseek/deepseek-v4-flash-0731=streamlake/fp8
# LLM_FALLBACK_MODEL=ollama/gemma4-16k:12b-mlx   (ollama/<model> = local Ollama; or any provider model id)
# EVAL_JUDGE_MODEL=                        (eval judge; ideally a different model)
# LLM_FAST_REASONING=low                   (OpenRouter reasoning effort: none|minimal|low|medium|high|xhigh)
# LLM_STRONG_REASONING=low
# RELEVANCE_CUTOFF=0.5                     (per-model; tune with pnpm eval:sweep)

# --- Firecrawl (web enrichment) --------------------------------------------
# Dev: self-hosted Firecrawl in podman (no key needed).
# Prod: leave FIRECRAWL_API_URL unset (defaults to https://api.firecrawl.dev) and set FIRECRAWL_API_KEY.
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=
WEB_ENRICH_ENABLED=true
WEB_ENRICH_TIMEOUT_MS=8000
# WEB_QUERY_SUFFIX="case law UK judgment"   # appended to the question for the web search

# Path to the local Firecrawl checkout (used by scripts/dev-services.sh)
FIRECRAWL_LOCAL_DIR=../firecrawl-local

# --- Local index (pnpm ingest / pnpm embed:backfill) -------------------------
# OLLAMA_URL=http://localhost:11434
# EMBED_MODEL=nomic-embed-text        # must output 768 dims (EMBED_DIM in src/db/schema.ts)
# EMBED_ENABLED=false                 # no embeddings at all (keyword-only ranking)
# LOCAL_INDEX=off                     # skip local candidate retrieval
# VECTOR_MIN_SIM=0.65                 # min cosine sim for a semantic paragraph hit
# LOCAL_VECTOR_CHUNKS=300             # nearest paragraphs scanned per query vector
# LOCAL_VECTOR_VARIANTS=2             # expansion variants embedded alongside the question
# LOCAL_VECTOR_MIN_WEIGHT=0.35        # floor of the coverage-scaled semantic list weight
# EMBED_FULL_BELOW=5                  # fewer keyword hits than this → embed the whole case
# EMBED_FULL_MAX=400                  #   …if it has at most this many paragraphs
# --- Relevance pre-screen (OpenRouter decisions model) ------------------------
# JUDGE_GATE_MODEL=typesafe/jev-1.13  # cheap typed decision before the strong judge; unset = off
# JUDGE_GATE_REJECT=0.75              # reject when P(tangential)+P(unrelated) ≥ this
# --- Cross-encoder reranker (local, transformers.js) ---------------------------
# RERANK_ENABLED=false
# RERANK_MODEL=Xenova/bge-reranker-base
# RERANK_POOL=16                      # keyword + semantic paragraphs scored per case
# RERANK_MIN=0.05                     # below this best score the case is rejected without LLM calls
# RERANK_TRUST=0.9                    # at or above this the Jev pre-screen is skipped
# --- Citation expansion -------------------------------------------------------
# CITE_MIN=2                          # read cases cited by at least this many passing results
# CITE_MAX=3                          #   …at most this many
# --- Latency ----------------------------------------------------------------
# FIRST_WAVE=6                        # cases read before web hints are merged
# CASE_CONCURRENCY=4                  # cases in the LLM stages at once
# EXPAND_CACHE=off                    # disable the 24h query-expansion cache
# LOCAL_LIST_SIZE=25                  # cases per local candidate list
# TNA_REQUEST_BUDGET=900              # shared TNA requests per 5 min (ingest + app)
