# --- Database ---------------------------------------------------------------
# Dev: Postgres from compose.yaml (podman). Prod: Neon connection string.
DATABASE_URL=postgres://caselaw:caselaw@localhost:5433/caselaw

# --- LLM --------------------------------------------------------------------
# Precedence: OPENROUTER_API_KEY → ANTHROPIC_API_KEY → AI_GATEWAY_API_KEY
# (Vercel AI Gateway; on Vercel, OIDC auth works without a key).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# Optional model overrides (ids for whichever provider is active)
# LLM_FAST_MODEL=claude-haiku-4-5          (OpenRouter e.g. stealth/space-bunny-alpha)
# LLM_STRONG_MODEL=claude-sonnet-5-5
# EVAL_JUDGE_MODEL=                        (eval judge; ideally a different model)
# LLM_FAST_REASONING=low                   (OpenRouter reasoning effort: none|minimal|low|medium|high|xhigh)
# LLM_STRONG_REASONING=low
# RELEVANCE_CUTOFF=0.5                     (per-model; tune with pnpm eval:sweep)

# --- Firecrawl (web enrichment) --------------------------------------------
# Dev: self-hosted Firecrawl in podman (no key needed).
# Prod: leave FIRECRAWL_API_URL unset (defaults to https://api.firecrawl.dev) and set FIRECRAWL_API_KEY.
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=
WEB_ENRICH_ENABLED=true
WEB_ENRICH_TIMEOUT_MS=8000

# Path to the local Firecrawl checkout (used by scripts/dev-services.sh)
FIRECRAWL_LOCAL_DIR=../firecrawl-local

# --- Local index (pnpm ingest / pnpm embed) ----------------------------------
# LOCAL_INDEX=off                     # skip local retrieval even when chunks exist
# EMBED_MODEL=Xenova/bge-small-en-v1.5  # must output 384 dims (EMBED_DIMS in src/db/schema.ts)
# VECTOR_MIN_SIM=0.6                  # min cosine sim for a semantic paragraph hit
# LOCAL_VECTOR_CHUNKS=300             # nearest chunks scanned per query
# LOCAL_LIST_SIZE=25                  # cases per local candidate list
# TNA_REQUEST_BUDGET=900              # shared TNA requests per 5 min (ingest + app)
